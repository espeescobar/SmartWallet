# ═══════════════════════════════════════════════════════════════════
# SmartWallet — Variables de entorno
#
# USO:
#   cp .env.example .env
#   Editar .env con tus valores reales (nunca subir .env a git)
#
# Las variables sin valor por defecto son OBLIGATORIAS.
# ═══════════════════════════════════════════════════════════════════


# ── Servidor API ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000


# ── PostgreSQL ──────────────────────────────────────────────────────
# Variables individuales — usadas por la API y por docker-compose
# para crear el contenedor de postgres

DB_HOST=localhost          # en docker-compose se sobreescribe a "postgres"
DB_PORT=5432
DB_NAME=smartwallet_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña_segura


# ── DATABASE_URL ────────────────────────────────────────────────────
# Alternativa a las variables individuales de arriba.
# Útil para deploys en Railway, Render, Heroku, etc.
# Si está definida, tiene PRECEDENCIA sobre DB_HOST/DB_PORT/etc.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS

DATABASE_URL=postgresql://postgres:cambia_esta_contraseña_segura@localhost:5432/smartwallet_db


# ── JWT ─────────────────────────────────────────────────────────────
# Generar un secreto seguro con:
#   openssl rand -hex 32
# Mínimo 32 caracteres aleatorios.

JWT_SECRET=reemplaza_con_64_chars_hexadecimales_generados_con_openssl
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d


# ── OpenAI — Chatbot de Educación Financiera ────────────────────────
# Obtener en: https://platform.openai.com/api-keys
# Dejar en blanco si el módulo de chatbot no está activo.

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── CORS ────────────────────────────────────────────────────────────
# Expo (React Native) corre en el puerto 8081 por defecto en desarrollo.
# En producción: dominio real de la app o "*" solo si no hay auth por cookie.

CORS_ORIGIN=http://localhost:8081


# ── pgAdmin (solo docker-compose, no lo lee la API) ─────────────────
# Credenciales para acceder a http://localhost:5050

PGADMIN_EMAIL=admin@smartwallet.dev
PGADMIN_PASSWORD=admin123
