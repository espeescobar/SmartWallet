# ═══════════════════════════════════════════════════════════════════
# SmartWallet Backend — Variables de entorno (uso standalone)
# Para uso con docker-compose, ver el .env.example en la raíz del proyecto.
#
# cp .env.example .env   →   editar los valores reales
# ═══════════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (vars individuales) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartwallet_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña_segura

# ── DATABASE_URL (alternativa a las vars individuales) ───────────────
# Si está definida, tiene PRECEDENCIA sobre DB_HOST/DB_PORT/etc.
# Generar con: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://postgres:cambia_esta_contraseña_segura@localhost:5432/smartwallet_db

# ── JWT ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=reemplaza_con_64_chars_hexadecimales_generados_con_openssl
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8081
