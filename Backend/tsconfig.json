{
  "compilerOptions": {
    "target":                     "es2022",
    "module":                     "commonjs",
    "lib":                        ["es2022"],
    "outDir":                     "./dist",
    "rootDir":                    "./",
    "esModuleInterop":            true,
    "forceConsistentCasingInFileNames": true,
    "strict":                     true,
    "skipLibCheck":               true,
    "resolveJsonModule":          true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
